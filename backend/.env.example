# ── KROS Backend Environment Variables ──────────────────────────
# Copy this to .env and fill in your actual keys
# NEVER commit .env to git

# ── AI Engine API Keys ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-claude-api-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# ── Server ───────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Auth ─────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=8h

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://kros_user:password@localhost:5432/kros_db

# ── Document Store ───────────────────────────────────────────────
# Option 1: Local files (development)
SKILLS_DIR=./skills

# Option 2: SharePoint (production)
# SHAREPOINT_TENANT_ID=your-tenant-id
# SHAREPOINT_CLIENT_ID=your-client-id
# SHAREPOINT_CLIENT_SECRET=your-client-secret
# SHAREPOINT_SITE_URL=https://yourcompany.sharepoint.com/sites/kros

# ── AI Routing ───────────────────────────────────────────────────
# auto | claude | deepseek
AI_ROUTING_MODE=auto

# ── Data Residency ───────────────────────────────────────────────
# Comma-separated sensitivity levels allowed on DeepSeek
# WARNING: Only use 'low' — never allow medium or high on DeepSeek
DEEPSEEK_ALLOWED_SENSITIVITY=low
